@page "/orders"
@attribute [StreamRendering]
@inject OrdersRepository OrdersRepository

<h3>Orders</h3>


@if (orderDetailsList is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="body-container">
        <table class="order-table">
            <thead>
                <tr class="table-header">
                    <th>Order Number</th>
                    <th>Order Total</th>
                    <th>Order Date</th>
                    <th>SKU List</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orderDetailsList)
                {
                    <OrderRow OrderDetails=order />
                    @* <tr>
                        <td>@order.OrderNumber</td>
                        <td>@order.TotalCost.ToString("C")</td>
                        <td>@order.OrderDate.ToString("d MMM yyyy")</td>
                        <td>@(string.Join(", ", order.SkuList!))</td>
                    </tr> *@
                }
            </tbody>
        </table>
    </div>
}



@code {
    private OrderWithDetails[]? orderDetailsList;

    protected override async Task OnInitializedAsync()
    {
        orderDetailsList = (await OrdersRepository.GetAllOrderDetails()).ToArray();
    }
}
